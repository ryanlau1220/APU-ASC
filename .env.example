# PostgreSQL Database Configuration
POSTGRES_DB=apu_asc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/apu_asc?sslmode=disable

# Keycloak Identity Provider Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
JWT_ISSUER_URI=http://localhost/auth/realms/apu-asc
KEYCLOAK_TOKEN_URI=http://localhost/auth/realms/apu-asc/protocol/openid-connect/token

# SMTP Email Configuration (Standard SMTP Provider)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Application Asset Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=apu-asc-assets

# Observability Identity and OpenTelemetry
OBSERVABILITY_ENVIRONMENT=development
OBSERVABILITY_RELEASE=dev
VITE_OBSERVABILITY_ENVIRONMENT=development
VITE_OBSERVABILITY_RELEASE=dev
OTEL_SERVICE_NAME=apu-asc-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACING_SAMPLING_PROBABILITY=1.0
OBSERVABILITY_PROMETHEUS_ALLOWED_CIDR=172.18.0.0/16
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_password
ALERT_EMAIL_TO=your-email@example.com

# Error Monitoring and Product Analytics
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Self-hosted Loki and Tempo Object Storage 
OBSERVABILITY_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OBSERVABILITY_S3_REGION=auto
OBSERVABILITY_S3_ACCESS_KEY=
OBSERVABILITY_S3_SECRET_KEY=
LOKI_S3_BUCKET=apu-asc-observability-loki
TEMPO_S3_BUCKET=apu-asc-observability-tempo

# PostgreSQL Point-in-Time Recovery Backups (WAL-G)
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
POSTGRES_BACKUP_S3_BUCKET=apu-asc-postgres-backups
WALG_PGP_KEY_PATH=/run/secrets/walg_pgp_public_key
