# Non-sensitive, disposable configuration for GitHub Actions test services.
POSTGRES_DB=apu_asc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_SERVER_URL=http://localhost/auth
KEYCLOAK_ADMIN_REALM=apu-asc
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/apu_asc?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=apu-asc-assets
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=minioadminpassword
APP_FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
OAUTH2_REDIRECT_URI=http://localhost:3000/login/oauth2/code/{registrationId}
JWT_ISSUER_URI=http://localhost/auth/realms/apu-asc
KEYCLOAK_AUTH_URI=http://localhost/auth/realms/apu-asc/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=http://localhost/auth/realms/apu-asc/protocol/openid-connect/token
KEYCLOAK_USERINFO_URI=http://localhost/auth/realms/apu-asc/protocol/openid-connect/userinfo
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost/auth/realms/apu-asc/protocol/openid-connect/certs
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
OBSERVABILITY_PROMETHEUS_ALLOWED_CIDR=127.0.0.1/32
GRAFANA_ADMIN_PASSWORD=ci-grafana-password
OBSERVABILITY_S3_ENDPOINT=http://minio:9000
OBSERVABILITY_S3_REGION=us-east-1
OBSERVABILITY_S3_ACCESS_KEY=minioadmin
OBSERVABILITY_S3_SECRET_KEY=minioadminpassword
LOKI_S3_BUCKET=ci-loki
TEMPO_S3_BUCKET=ci-tempo
