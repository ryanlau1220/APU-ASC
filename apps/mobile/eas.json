{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8081",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "http://localhost/auth/realms/apu-asc",
        "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID": "apu-asc-mobile"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://apu-asc.duckdns.org",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "https://apu-asc.duckdns.org/auth/realms/apu-asc",
        "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID": "apu-asc-mobile"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://apu-asc.duckdns.org",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "https://apu-asc.duckdns.org/auth/realms/apu-asc",
        "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID": "apu-asc-mobile"
      }
    }
  }
}
