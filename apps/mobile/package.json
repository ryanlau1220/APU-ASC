{
  "name": "@apu-asc/mobile",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --port 8082",
    "android": "(adb reverse tcp:8081 tcp:8081 || true) && (adb reverse tcp:8080 tcp:80 || true) && (adb reverse tcp:8082 tcp:8082 || true) && expo start --dev-client --android --port 8082",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "generate:api": "orval --biome",
    "verify": "expo export --platform android --output-dir /tmp/apu-asc-mobile-export"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.10",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "orval": "^7.21.0",
    "typescript": "~6.0.3"
  }
}
