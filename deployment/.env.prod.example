# Copy this file to deployment/.env.prod on the VPS. Keep that file out of Git.
APP_DOMAIN=apu-asc.duckdns.org
APP_FRONTEND_BASE_URL=https://apu-asc.duckdns.org
NPM_NETWORK_NAME=npm_default
APU_ASC_NETWORK_SUBNET=172.30.0.0/16

# Application database and cache
POSTGRES_DB=apu_asc
POSTGRES_USER=apu_asc
POSTGRES_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-password
VALKEY_PASSWORD=replace-with-a-long-random-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/apu_asc?sslmode=disable
SPRING_DATASOURCE_USERNAME=apu_asc
SPRING_DATASOURCE_PASSWORD=replace-with-the-postgres-password
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Keycloak uses the public URL for browser redirects and its Docker name for private service calls.
KEYCLOAK_ADMIN=replace-with-bootstrap-admin-username
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN_USERNAME=replace-with-bootstrap-admin-username
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080/auth
KEYCLOAK_ADMIN_REALM=apu-asc
INITIAL_MANAGER_USERNAME=replace-with-your-initial-manager-username
INITIAL_MANAGER_EMAIL=your-manager-email@example.com
INITIAL_MANAGER_PASSWORD=replace-with-a-long-random-password
OAUTH2_REDIRECT_URI=https://apu-asc.duckdns.org/login/oauth2/code/{registrationId}
JWT_ISSUER_URI=https://apu-asc.duckdns.org/auth/realms/apu-asc
KEYCLOAK_AUTH_URI=https://apu-asc.duckdns.org/auth/realms/apu-asc/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=http://keycloak:8080/auth/realms/apu-asc/protocol/openid-connect/token
KEYCLOAK_USERINFO_URI=http://keycloak:8080/auth/realms/apu-asc/protocol/openid-connect/userinfo
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/auth/realms/apu-asc/protocol/openid-connect/certs
CORS_ALLOWED_ORIGINS=https://apu-asc.duckdns.org

# SMTP
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-smtp-app-password

# Application assets (an R2 bucket created in advance)
S3_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=replace-with-r2-access-key
S3_SECRET_KEY=replace-with-r2-secret-key
S3_BUCKET=apu-asc-assets

# Application observability
OBSERVABILITY_ENVIRONMENT=production
OBSERVABILITY_RELEASE=manual
OTEL_SERVICE_NAME=apu-asc-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACING_SAMPLING_PROBABILITY=0.25
OBSERVABILITY_PROMETHEUS_ALLOWED_CIDR=172.30.0.0/16
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_OBSERVABILITY_ENVIRONMENT=production
VITE_OBSERVABILITY_RELEASE=manual
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Grafana, Alertmanager, Loki and Tempo
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
ALERT_EMAIL_TO=your-alert-recipient@example.com
OBSERVABILITY_S3_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
OBSERVABILITY_S3_REGION=auto
OBSERVABILITY_S3_ACCESS_KEY=replace-with-r2-access-key
OBSERVABILITY_S3_SECRET_KEY=replace-with-r2-secret-key
LOKI_S3_BUCKET=apu-asc-observability-loki
TEMPO_S3_BUCKET=apu-asc-observability-tempo

# WAL-G point-in-time recovery. Only the public key is mounted in running containers.
BACKUP_S3_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=replace-with-r2-access-key
BACKUP_S3_SECRET_KEY=replace-with-r2-secret-key
POSTGRES_BACKUP_S3_BUCKET=apu-asc-postgres-backups
WALG_PGP_PUBLIC_KEY_PATH=/opt/apu-asc/.secrets/walg/walg-public.asc
