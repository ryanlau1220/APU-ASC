{
  "id": "apu-asc",
  "realm": "apu-asc",
  "displayName": "APU Automotive Service Centre",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "MANAGER",
        "description": "System Manager with full administrative control"
      },
      {
        "name": "STAFF",
        "description": "Counter Staff with booking & billing privileges"
      },
      {
        "name": "TECHNICIAN",
        "description": "Technician with job ticket & inspection privileges"
      },
      {
        "name": "CUSTOMER",
        "description": "Customer account for service appointments"
      }
    ]
  },
  "clients": [
    {
      "clientId": "apu-asc-web",
      "name": "APU-ASC Web Client",
      "description": "Public SPA/SSR Client using OAuth2 PKCE",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost/*",
        "http://localhost/login/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost",
        "+"
      ]
    },
    {
      "clientId": "apu-asc-api",
      "name": "APU-ASC Backend API Service",
      "description": "OAuth2 Resource Server Audience Client",
      "enabled": true,
      "bearerOnly": true
    }
  ],
