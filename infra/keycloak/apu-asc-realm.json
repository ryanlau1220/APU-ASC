{
  "id": "apu-asc",
  "realm": "apu-asc",
  "displayName": "APU Automotive Service Centre",
  "loginTheme": "apu-asc",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": true,
  "defaultRoles": ["CUSTOMER"],
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "${SMTP_HOST:smtp.gmail.com}",
    "port": "${SMTP_PORT:587}",
    "from": "${SMTP_FROM:liujunhong20@gmail.com}",
    "fromDisplayName": "APU-ASC Security",
    "auth": "true",
    "ssl": "false",
    "starttls": "true",
    "user": "${SMTP_USERNAME:liujunhong20@gmail.com}",
    "password": "${SMTP_PASSWORD:}"
  },
  "roles": {
    "realm": [
      {
        "name": "SYSTEM_ADMIN",
        "description": "System Administrator with full control"
      },
      {
        "name": "MANAGER",
        "description": "Workshop Manager with administrative control"
      },
      {
        "name": "STAFF",
        "description": "Counter Staff with booking & billing privileges"
      },
      {
        "name": "TECHNICIAN",
        "description": "Technician with job ticket & inspection privileges"
      },
      {
        "name": "CUSTOMER",
        "description": "Customer account for service appointments"
      }
    ]
  },
  "clients": [
    {
      "clientId": "apu-asc-web",
      "name": "APU-ASC Web Client",
      "description": "Public SPA/SSR Client using OAuth2 PKCE",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8081/*",
        "http://localhost:8081/login/oauth2/code/*",
        "http://localhost/login/oauth2/code/*",
        "http://localhost/*",
        "http://localhost/login/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8081",
        "http://localhost",
        "+"
      ]
    },
    {
      "clientId": "apu-asc-api",
      "name": "APU-ASC Backend API Service",
      "description": "OAuth2 Resource Server Audience Client",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@apu-asc.com",
      "firstName": "System",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["SYSTEM_ADMIN", "MANAGER"]
    }
  ]
}
